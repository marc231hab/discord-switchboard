# Save the filled copy under config/opencode/assistant.env.
DISCORD_CHANNEL_ID="REPLACE_WITH_OPENCODE_CHANNEL_ID"
CHANNEL_NAME=assistant-opencode
PROJECT_DIR="$HOME/projects/example-project"
OPENCODE_UNIT=discord-switchboard-opencode
OPENCODE_TMUX_SESSION=assistant-opencode
OPENCODE_PORT=4501
OPENCODE_URL=http://127.0.0.1:4501
OPENCODE_SESSION_ID="REPLACE_WITH_PINNED_OPENCODE_SESSION_ID"
OPENCODE_PASSWORD_FILE="$HOME/.config/discord-switchboard/opencode-password"
OPENCODE_BRIDGE_HOME="$HOME/.local/state/discord-switchboard/opencode-assistant"
# Optional OpenCode configuration file; keep provider credentials outside this repository.
OPENCODE_CONFIG=""
OPENCODE_ALWAYS_APPROVE=off
