# Save the filled copy under config/grok/assistant.env.
DISCORD_CHANNEL_ID="REPLACE_WITH_GROK_CHANNEL_ID"
CHANNEL_NAME=assistant-grok
PROJECT_DIR="$HOME/projects/example-project"
GROK_SESSION_ID="REPLACE_WITH_PINNED_GROK_SESSION_ID"
GROK_HOST=local
GROK_BINARY=grok
# For a remote host: set GROK_HOST=user@your-host; ssh or tailscale.
GROK_TRANSPORT=ssh
GROK_BRIDGE_UNIT=discord-switchboard-grok
GROK_TMUX_LABEL=assistant-grok
GROK_BRIDGE_HOME="$HOME/.local/state/discord-switchboard/grok-assistant"
GROK_ALWAYS_APPROVE=off
