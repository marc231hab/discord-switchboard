# Private local configuration. Replace both placeholders before starting.
DISCORD_BOT_TOKEN="REPLACE_WITH_BOT_TOKEN"
DISCORD_ALLOWED_USER_IDS="REPLACE_WITH_YOUR_USER_ID"
DISCORD_TASK_THREADS=on
# Optional channel for the shared overview; otherwise the first binding is used.
DISCORD_OVERVIEW_CHANNEL_ID=""
ROUTER_TMUX_SESSION=discord-router
SOCKET_DIR="${XDG_RUNTIME_DIR:-/tmp}/discord-switchboard-$UID"
DISCORD_STATE_DIR="$HOME/.local/state/discord-switchboard"
# Native CLI approval rules apply unless you explicitly opt in below.
AGENT_UNATTENDED=off
