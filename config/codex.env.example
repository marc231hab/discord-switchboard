# Save the filled copy under config/codex/assistant.env.
DISCORD_CHANNEL_ID="REPLACE_WITH_CODEX_CHANNEL_ID"
CHANNEL_NAME=assistant-codex
PROJECT_DIR="$HOME/projects/example-project"
TMUX_SESSION=assistant-codex
# Use a separate home per binding. Its config.toml is generated by the launcher.
CODEX_HOME="$HOME/.config/discord-switchboard/codex-assistant"
# Existing default-login auth is shared only if this home has no auth.json.
CODEX_AUTH_FILE="$HOME/.codex/auth.json"
CODEX_MODEL=""
CODEX_EFFORT=""
# Optional explicit UUID for an existing session in this project/home.
CODEX_THREAD_ID=""
